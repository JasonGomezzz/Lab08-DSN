# Copiar a .env y sustituir todos los valores CAMBIAR.
# Generar secretos aleatorios con: openssl rand -base64 48

# Base de datos MySQL
DB_USER=techstore
DB_PASSWORD=CAMBIAR_PASSWORD_BD
DB_ROOT_PASSWORD=CAMBIAR_PASSWORD_ROOT_BD

# Firma de los JWT (mínimo 32 bytes)
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS

# Cifrado en reposo de los secretos TOTP (mínimo 32 bytes, distinto de JWT_SECRET)
MFA_CLAVE_CIFRADO=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS

# Administrador inicial. Si se omiten, no se crea ningún administrador.
ADMIN_EMAIL=admin@techstore.example
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# Datos de demostración (tiendas ya vienen en la migración; productos y usuarios por perfil)
# Poner en true solo en local.
TECHSTORE_DATOS_DEMO=false
DEMO_PASSWORD=CAMBIAR_PASSWORD_DEMO

# Login social. Si se dejan vacíos, el proveedor no se habilita.
# Redirect URI en Google:  ${TECHSTORE_BASE_URL}/login/oauth2/code/google
# Callback URL en GitHub:  ${TECHSTORE_BASE_URL}/login/oauth2/code/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL pública del backend (para el redirect de OAuth2) y de la interfaz (destino tras el login social).
# Con Docker (un solo contenedor) son la misma. Con "npm run dev" la interfaz vive en http://localhost:5173.
TECHSTORE_BASE_URL=http://localhost:8080
TECHSTORE_FRONTEND_URL=http://localhost:8080
